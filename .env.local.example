# eBay Developer Credentials (Production keys from https://developer.ebay.com/my/keys)
EBAY_APP_ID=your_app_id_here
EBAY_CERT_ID=your_cert_id_here

# Sign in with Apple token revocation on account delete (lib/appleAuth.js).
# Optional: leave blank and everything works as before. Secret: never commit.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.fieldsandfloors.app
APPLE_PRIVATE_KEY=

# Show "Continue with Apple" on the website's sign-up prompt. Leave unset (or
# 0) until Sign in with Apple is set up for the web (Apple Services ID in
# Supabase); the iPhone app always uses its own native Apple sign-in.
NEXT_PUBLIC_APPLE_WEB=

# PostHog product analytics (lib/posthog.js). Optional: leave the key blank and
# PostHog is never loaded. The host is the PostHog region (EU recommended).
# The key is a public project key (it ships in the browser), not a secret.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# /admin/visitors: reads PostHog numbers on the server (never sent to the browser).
# POSTHOG_PERSONAL_API_KEY is a SECRET: a PostHog personal API key with read-only
# query access. Leave both blank and the page says it is waiting for the key.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Optional, only if the PostHog project is not on the EU cloud app host.
POSTHOG_API_HOST=
